rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function isActiveAdmin() {
      return signedIn()
        && exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.role == 'admin'
        && get(userPath(request.auth.uid)).data.status == 'active';
    }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function isActiveCourier() {
      return signedIn()
        && exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.role == 'courier'
        && get(userPath(request.auth.uid)).data.status == 'active';
    }
    function courierPath(uid) { return /databases/$(database)/documents/couriers/$(uid); }
    function orderPath(id) { return /databases/$(database)/documents/orders/$(id); }

    // users/{uid}: role and account status are the source of truth (ADR-6).
    match /users/{uid} {
      function isSelf() { return signedIn() && request.auth.uid == uid; }

      // Status a self-registered account must start with; mirrors RegistrationPolicy (Kotlin).
      function defaultStatusFor(role) {
        return (role == 'customer' && request.resource.data.status == 'active')
          || ((role == 'merchant' || role == 'courier') && request.resource.data.status == 'pending');
      }
      function validRegistration() {
        let data = request.resource.data;
        return isSelf()
          && data.keys().hasOnly(['role', 'status', 'displayName', 'email', 'phone', 'createdAt'])
          && data.keys().hasAll(['role', 'status', 'displayName', 'email', 'phone', 'createdAt'])
          && defaultStatusFor(data.role)
          && data.createdAt == request.time;
      }
      function profileUpdate() {
        return isSelf() && changed().hasOnly(['displayName', 'phone']);
      }
      function adminStatusUpdate() {
        return isActiveAdmin()
          && changed().hasOnly(['status'])
          && request.resource.data.status in ['active', 'pending', 'suspended'];
      }

      allow read: if isSelf() || isActiveAdmin();
      allow create: if validRegistration();
      allow update: if profileUpdate() || adminStatusUpdate();
      allow delete: if false;
    }

    function validText(value, min, max) {
      return value is string && value.trim().size() >= min && value.size() <= max;
    }

    // merchants/{uid}: public storefront profile; catalog lives in subcollections (ADR-11).
    match /merchants/{mid} {
      // Writes require the owner's users document (source of truth, ADR-6) to be an active merchant.
      function isActiveMerchant() {
        return signedIn()
          && request.auth.uid == mid
          && exists(userPath(mid))
          && get(userPath(mid)).data.role == 'merchant'
          && get(userPath(mid)).data.status == 'active';
      }
      function validLocation(location) {
        return location is map
          && location.keys().hasOnly(['lat', 'lng', 'reference'])
          && location.keys().hasAll(['lat', 'lng', 'reference'])
          && location.lat is number && location.lat >= -90 && location.lat <= 90
          && location.lng is number && location.lng >= -180 && location.lng <= 180
          && validText(location.reference, 0, 200);
      }
      function validProfile(data) {
        return validText(data.name, 1, 80)
          && validText(data.description, 0, 500)
          && validText(data.phone, 1, 30)
          && data.isOpen is bool
          && (!('photoVersion' in data) || (data.photoVersion is int && data.photoVersion >= 0))
          && validLocation(data.location);
      }
      // Created by the merchant, in the same batch as users/{uid} at registration or later on retry.
      // Registration collects the store name, contact phone and map pin, so all three are required.
      function validMerchantCreate() {
        let data = request.resource.data;
        return signedIn()
          && request.auth.uid == mid
          && getAfter(userPath(mid)).data.role == 'merchant'
          && data.keys().hasOnly(['name', 'description', 'phone', 'status', 'isOpen', 'photoVersion', 'location', 'createdAt', 'updatedAt'])
          && data.keys().hasAll(['name', 'description', 'phone', 'status', 'isOpen', 'location', 'createdAt', 'updatedAt'])
          && data.status == 'pending'
          && data.isOpen == false
          && data.createdAt == request.time
          && data.updatedAt == request.time
          && validProfile(data);
      }
      function ownerUpdate() {
        return isActiveMerchant()
          && changed().hasOnly(['name', 'description', 'phone', 'isOpen', 'photoVersion', 'location', 'updatedAt'])
          && request.resource.data.updatedAt == request.time
          && validProfile(request.resource.data);
      }
      function adminStatusMirror() {
        return isActiveAdmin()
          && changed().hasOnly(['status', 'updatedAt'])
          && request.resource.data.status in ['active', 'pending', 'suspended']
          && (!('updatedAt' in changed()) || request.resource.data.updatedAt == request.time);
      }

      allow read: if signedIn();
      allow create: if validMerchantCreate();
      allow update: if ownerUpdate() || adminStatusMirror();
      allow delete: if false;

      match /categories/{cid} {
        function validCategory() {
          let data = request.resource.data;
          return data.keys().hasOnly(['name', 'sortOrder'])
            && data.keys().hasAll(['name', 'sortOrder'])
            && validText(data.name, 1, 60)
            && data.sortOrder is int;
        }
        allow read: if signedIn();
        allow create, update: if isActiveMerchant() && validCategory();
        allow delete: if isActiveMerchant();
      }

      match /products/{pid} {
        function validProduct() {
          let data = request.resource.data;
          return data.keys().hasOnly(['categoryId', 'name', 'description', 'priceCents', 'isAvailable', 'photoVersion', 'updatedAt'])
            && data.keys().hasAll(['categoryId', 'name', 'description', 'priceCents', 'isAvailable', 'photoVersion', 'updatedAt'])
            && data.categoryId is string && data.categoryId.size() > 0
            && validText(data.name, 1, 80)
            && validText(data.description, 0, 500)
            && data.priceCents is int && data.priceCents > 0
            && data.isAvailable is bool
            && data.photoVersion is int && data.photoVersion >= 0
            && data.updatedAt == request.time;
        }
        allow read: if signedIn();
        allow create, update: if isActiveMerchant() && validProduct();
        allow delete: if isActiveMerchant();
      }

      // Compressed JPEG bytes (max 640 px, quality ~70) stored in Firestore because Cloud Storage needs Blaze.
      match /productPhotos/{pid} {
        function validPhoto() {
          let data = request.resource.data;
          return data.keys().hasOnly(['jpeg', 'version'])
            && data.keys().hasAll(['jpeg', 'version'])
            && data.jpeg is bytes && data.jpeg.size() <= 307200
            && data.version is int && data.version >= 0;
        }
        allow read: if signedIn();
        allow create, update: if isActiveMerchant() && validPhoto();
        allow delete: if isActiveMerchant();
      }
    }

    // settings/app: platform configuration. Orders snapshot its flat delivery fee at placement (ADR-10).
    // Clients only read it; the Admin fee editor and its write rule arrive in Slice 6.
    match /settings/app {
      allow read: if signedIn();
      allow write: if false;
    }

    // orders/{orderId}: created by an active customer; the fee is a snapshot that later settings changes never touch.
    match /orders/{orderId} {
      function isActiveCustomer() {
        return signedIn()
          && exists(userPath(request.auth.uid))
          && get(userPath(request.auth.uid)).data.role == 'customer'
          && get(userPath(request.auth.uid)).data.status == 'active';
      }
      function merchantDoc(merchantId) {
        return get(/databases/$(database)/documents/merchants/$(merchantId)).data;
      }
      function validPin(pin) {
        return pin is map
          && pin.keys().hasOnly(['lat', 'lng', 'reference'])
          && pin.keys().hasAll(['lat', 'lng', 'reference'])
          && pin.lat is number && pin.lat >= -90 && pin.lat <= 90
          && pin.lng is number && pin.lng >= -180 && pin.lng <= 180
          && validText(pin.reference, 0, 200);
      }
      // Rules cannot loop over items, so only the aggregates are checked (ADR-10); the merchant reviews prices on accept.
      function validPlacement() {
        let data = request.resource.data;
        let fee = get(/databases/$(database)/documents/settings/app).data.deliveryFeeCents;
        return isActiveCustomer()
          && data.keys().hasOnly(['customerId', 'customerName', 'customerPhone', 'merchantId', 'merchantName', 'pickup', 'dropoff',
            'items', 'subtotalCents', 'deliveryFeeCents', 'totalCents', 'paymentMethod', 'status', 'courierId', 'createdAt', 'updatedAt'])
          && data.keys().hasAll(['customerId', 'customerName', 'customerPhone', 'merchantId', 'merchantName', 'pickup', 'dropoff',
            'items', 'subtotalCents', 'deliveryFeeCents', 'totalCents', 'paymentMethod', 'status', 'courierId', 'createdAt', 'updatedAt'])
          && data.customerId == request.auth.uid
          && validText(data.customerName, 1, 80)
          && validText(data.customerPhone, 1, 30)
          && validText(data.merchantName, 1, 80)
          && data.merchantId is string && data.merchantId.size() > 0
          && merchantDoc(data.merchantId).status == 'active'
          && merchantDoc(data.merchantId).isOpen == true
          && validPin(data.pickup)
          && validPin(data.dropoff)
          && data.items is list && data.items.size() >= 1 && data.items.size() <= 30
          && data.subtotalCents is int && data.subtotalCents > 0
          && data.deliveryFeeCents == fee
          && data.totalCents == data.subtotalCents + data.deliveryFeeCents
          && data.paymentMethod == 'cash'
          && data.status == 'placed'
          && data.courierId == null
          && data.createdAt == request.time
          && data.updatedAt == request.time;
      }

      function isActiveMerchant() {
        return signedIn()
          && exists(userPath(request.auth.uid))
          && get(userPath(request.auth.uid)).data.role == 'merchant'
          && get(userPath(request.auth.uid)).data.status == 'active';
      }
      function moves(from, to) { return resource.data.status == from && request.resource.data.status == to; }
      function stamped(field) { return request.resource.data[field] == request.time && request.resource.data.updatedAt == request.time; }

      // Each transition touches only its own fields, so the placed snapshot (items, totals, fee) stays immutable.
      function merchantStep() {
        return isActiveMerchant() && resource.data.merchantId == request.auth.uid
          && ((moves('placed', 'accepted') && changed().hasOnly(['status', 'acceptedAt', 'updatedAt']) && stamped('acceptedAt'))
            || (moves('accepted', 'preparing') && changed().hasOnly(['status', 'preparingAt', 'updatedAt']) && stamped('preparingAt'))
            || (moves('preparing', 'ready') && changed().hasOnly(['status', 'readyAt', 'updatedAt']) && stamped('readyAt')));
      }
      function merchantReject() {
        return isActiveMerchant() && resource.data.merchantId == request.auth.uid
          && moves('placed', 'rejected')
          && changed().hasOnly(['status', 'rejectReason', 'rejectedAt', 'updatedAt'])
          && stamped('rejectedAt')
          && validText(request.resource.data.rejectReason, 1, 200);
      }
      function customerCancel() {
        return isActiveCustomer() && resource.data.customerId == request.auth.uid
          && moves('placed', 'cancelled')
          && changed().hasOnly(['status', 'cancelledBy', 'cancelledAt', 'updatedAt'])
          && stamped('cancelledAt')
          && request.resource.data.cancelledBy == 'customer';
      }
      // The race-safe claim (ADR-7): one write on the order and one on the courier's slot, each requiring the
      // other through getAfter(), so neither can commit alone and a second claim finds the order or the slot taken.
      function claim() {
        let c = courierPath(request.auth.uid);
        return isActiveCourier() && moves('ready', 'claimed')
          && resource.data.courierId == null
          && request.resource.data.courierId == request.auth.uid
          && changed().hasOnly(['status', 'courierId', 'claimedAt', 'updatedAt'])
          && stamped('claimedAt')
          && get(c).data.isOnline == true
          && get(c).data.activeOrderId == null
          && getAfter(c).data.activeOrderId == orderId;
      }
      function pickUp() {
        return isActiveCourier() && moves('claimed', 'picked_up')
          && resource.data.courierId == request.auth.uid
          && changed().hasOnly(['status', 'pickedUpAt', 'updatedAt'])
          && stamped('pickedUpAt');
      }
      // Delivering frees the courier's slot in the same write; the slot must hold this very order beforehand,
      // so the order cannot be delivered without clearing it (ADR-7 release path).
      function deliver() {
        let c = courierPath(request.auth.uid);
        return isActiveCourier() && moves('picked_up', 'delivered')
          && resource.data.courierId == request.auth.uid
          && changed().hasOnly(['status', 'deliveredAt', 'updatedAt'])
          && stamped('deliveredAt')
          && get(c).data.activeOrderId == orderId
          && getAfter(c).data.activeOrderId == null;
      }
      // The Admin release/cancel are implemented in Slice 6.
      function courierStep() { return claim() || pickUp() || deliver(); }
      function adminStep() { return false; }

      // The pool is every ready order for any active courier; the dropoff and customer contact are readable
      // before the claim because rules cannot hide fields (accepted risk, ADR-7). A courier also reads the
      // orders assigned to them, whatever their status.
      function courierRead() {
        return isActiveCourier() && (resource.data.courierId == request.auth.uid || resource.data.status == 'ready');
      }

      // The owner customer, the addressed merchant, Admin and couriers (the pool and their own orders).
      allow read: if signedIn()
        && (resource.data.customerId == request.auth.uid || resource.data.merchantId == request.auth.uid || isActiveAdmin() || courierRead());
      allow create: if validPlacement();
      allow update: if merchantStep() || merchantReject() || customerCancel() || courierStep() || adminStep();
      allow delete: if false;
    }

    // couriers/{uid}: availability and the active order slot of a courier (ADR-7). The claim and deliver
    // writes that fill and free `activeOrderId` are paired with the order write.
    match /couriers/{uid} {
      function isSelf() { return signedIn() && request.auth.uid == uid; }
      // Created by the courier in the same batch as users/{uid} at registration (or later on retry), offline and free.
      function validCourierCreate() {
        let data = request.resource.data;
        return isSelf()
          && getAfter(userPath(uid)).data.role == 'courier'
          && data.keys().hasOnly(['isOnline', 'activeOrderId', 'updatedAt'])
          && data.keys().hasAll(['isOnline', 'activeOrderId', 'updatedAt'])
          && data.isOnline == false
          && data.activeOrderId == null
          && data.updatedAt == request.time;
      }
      // Going offline is refused while a delivery is under way; going (or staying) online never is.
      function availability() {
        return isSelf() && isActiveCourier()
          && changed().hasOnly(['isOnline', 'updatedAt'])
          && request.resource.data.isOnline is bool
          && request.resource.data.updatedAt == request.time
          && (request.resource.data.isOnline == true || resource.data.activeOrderId == null);
      }

      // The slot is filled with the order's claim: the courier's write requires the order to be ready before
      // and claimed by this courier after, and the order's claim requires this slot to hold its id (ADR-7).
      function pairedClaim() {
        let id = request.resource.data.activeOrderId;
        return isSelf() && isActiveCourier()
          && resource.data.activeOrderId == null
          && id is string
          && changed().hasOnly(['activeOrderId', 'updatedAt'])
          && request.resource.data.updatedAt == request.time
          && get(orderPath(id)).data.status == 'ready'
          && getAfter(orderPath(id)).data.status == 'claimed'
          && getAfter(orderPath(id)).data.courierId == uid;
      }

      // The slot is freed with the order's delivery: the courier's write requires the order to be delivered after it.
      function pairedDeliver() {
        let id = resource.data.activeOrderId;
        return isSelf() && isActiveCourier()
          && id is string
          && request.resource.data.activeOrderId == null
          && changed().hasOnly(['activeOrderId', 'updatedAt'])
          && request.resource.data.updatedAt == request.time
          && getAfter(orderPath(id)).data.status == 'delivered';
      }

      allow read: if isSelf() || isActiveAdmin();
      allow create: if validCourierCreate();
      allow update: if availability() || pairedClaim() || pairedDeliver();
      allow delete: if false;
    }

    // Everything else stays denied until its slice adds a match block test-first.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
